{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunities",
  "account_id": "091539408595ba99a0ef106d42391d5b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://opportunities.campusloop.space",
    "CAMPUSLOOP_ISSUER": "https://campusloop.space"
  },
  "routes": [
    {
      "pattern": "opportunities.campusloop.space",
      "custom_domain": true
    }
  ]
}
